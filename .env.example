# Delta Chat WebPreview Bot Configuration Example
# Copy this file to .env and configure the values

# Comma-separated list of allowed bot emails (optional)
ALLOWED_BOT_EMAILS=

# OGInstagram Integration (optional, enables rich Instagram previews with images and captions, defaults to oginstagram.com)
# https://github.com/seirenkr/OGInstagram
OGINSTAGRAM_HOST=oginstagram.com

# Jina AI Reader API Key (optional, increases rate limits for r.jina.ai from 20 req/min to 500+ req/min)
JINA_API_KEY=
# Optional dedicated proxy for Jina AI Reader requests (e.g. http://127.0.0.1:8118)
JINA_PROXY_URL=

# Google Gemini API Key (optional, enables article TL;DR summarization with /tldr, AI questions with /ai, and in /preview or /webxdc captions)
GEMINI_API_KEY=
# Optional comma-separated Gemini models fallback chain (defaults to gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-2.5-flash-lite)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-2.5-flash-lite

# Proxy Configuration (optional, routes specific domains through a proxy)
# E.g., http://127.0.0.1:8118 or socks5://127.0.0.1:9050
PROXY_URL=
# Comma-separated list of domain suffixes to route via proxy (defaults to .ru)
PROXY_DOMAINS=.ru

# KaraKeep Integration (optional, admin-only bookmarks)
KARAKEEP_URL=
KARAKEEP_API_KEY=
# Optional comma-separated list of tags to automatically attach to saved bookmarks (e.g. deltachat)
KARAKEEP_TAGS=

# Storage and cleanup settings (optional)
# Local message retention duration in seconds (default: 3600 / 1 hour)
DELETE_DEVICE_AFTER=3600
# Automatic download limit for incoming attachments in bytes (default: 1 / disable)
DOWNLOAD_LIMIT=1

