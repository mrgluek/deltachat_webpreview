# Delta Chat WebPreview Bot Configuration Example
# Copy this file to .env and configure the values

# Comma-separated list of allowed bot emails (optional)
ALLOWED_BOT_EMAILS=

# OGInstagram Integration (optional, enables rich Instagram previews with images and captions, defaults to oginstagram.com)
# https://github.com/seirenkr/OGInstagram
OGINSTAGRAM_HOST=oginstagram.com

# Jina AI Reader API Key (optional, increases rate limits for r.jina.ai from 20 req/min to 500+ req/min)
JINA_API_KEY=
# Optional dedicated proxy for Jina AI Reader requests (e.g. http://127.0.0.1:8118)
JINA_PROXY_URL=

# Google Gemini API Key (optional, enables article TL;DR summarization with /tldr, AI questions with /ai, and in /preview or /webxdc captions)
GEMINI_API_KEY=
# Optional paid Gemini key that enables /google (Gemini answers grounded in Google Search; Search is not available on the free tier). Used for nothing else. If it is rejected (e.g. prepaid credits depleted) /google pauses for an hour
GEMINI_SEARCH_API_KEY=
# Optional comma-separated Gemini models fallback chain (defaults to gemini-4-hydrogen,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it)
GEMINI_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
# Optional total seconds the whole Gemini fallback chain may take before giving up (then OpenRouter is tried). Default 30
GEMINI_TIME_BUDGET=30
# Optional built-in Gemini tools for /ai only, comma-separated, all off by default: code_execution, url_context, google_search.
# Prefer /google (GEMINI_SEARCH_API_KEY) for web search; google_search here needs a paid GEMINI_API_KEY. A rejected tool is dropped and the same model is retried without it
GEMINI_TOOLS=
# /ai limits: characters of article/quoted text sent to the model (1000-200000, default 16000) and its output cap in tokens (512-16384, default 4096; thinking counts against it). The prompt still asks for 2-3 paragraphs
AI_CONTEXT_CHARS=16000
AI_MAX_OUTPUT_TOKENS=4096
# Optional wording that tells /ai and /google how long and deep to answer (goes into the prompt as is). Empty = built-in default: short and direct for simple questions, reasoned for complex ones
AI_ANSWER_STYLE=

# OpenRouter API Key (optional, last-resort fallback when every Gemini model fails; also works without GEMINI_API_KEY)
# Free key: https://openrouter.ai/keys  (text and images only, no audio)
OPENROUTER_API_KEY=
# Optional comma-separated OpenRouter models tried in order. Empty = built-in list of tested free chat models,
# ending with openrouter/free (routes to any available free model)
OPENROUTER_MODELS=

# Proxy Configuration (optional, routes specific domains through a proxy)
# E.g., http://127.0.0.1:8118 or socks5://127.0.0.1:9050 (RU_PROXY is also recognized as an alias)
PROXY_URL=
# Comma-separated list of domain suffixes to route via proxy (defaults to .ru, supports .su, .рф, etc.)
PROXY_DOMAINS=.ru,.su,.рф

# Dedicated proxy for Instagram/OGInstagram requests & thumbnail downloads (e.g. your UK residential router)
INSTAGRAM_PROXY_URL=

# KaraKeep Integration (optional, admin-only bookmarks)
KARAKEEP_URL=
KARAKEEP_API_KEY=
# Optional comma-separated list of tags to automatically attach to saved bookmarks (e.g. deltachat)
KARAKEEP_TAGS=

# Storage and cleanup settings (optional)
# Local message retention duration in seconds (default: 3600 / 1 hour)
DELETE_DEVICE_AFTER=3600
# Automatic download limit for incoming attachments in bytes (default: 1 / disable)
DOWNLOAD_LIMIT=65536

